# LLM API Keys — set the ones you have, leave others blank.
# Any LLM without a key will use mock data instead.

# OpenAI (ChatGPT)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Perplexity
# https://docs.perplexity.ai/
PERPLEXITY_API_KEY=

# Anthropic (Claude)
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Google Gemini
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
